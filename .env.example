# ══════════════════════════════════════════════════════
#  TaskFlow — Environment Configuration Template
#  Sao chép file này thành .env và điền giá trị thực
#  cp .env.example .env
# ══════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────
# Local:   mongodb://localhost:27017
# Docker:  mongodb://mongo:27017
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017

# Tên database
DB_NAME=taskflow

# ── Bảo mật ────────────────────────────────────────────
# ⚠️  BẮT BUỘC đổi giá trị này trước khi deploy!
# Tạo key mới: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY

# Thời gian token hết hạn (phút) — mặc định 8 giờ
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ───────────────────────────────────────────────
# Development local: http://localhost:8000
# Production:        https://app.company.com
ALLOWED_ORIGINS=http://localhost:8000

# ── Giới hạn upload ────────────────────────────────────
# File đính kèm task / CV (MB)
UPLOAD_MAX_MB=10

# Ảnh chuyển khoản, avatar, mã QR (MB)
IMAGE_MAX_MB=5
